{
  "asyncapi": "3.0.0",
  "info": {
    "title": "${TITLE}",
    "version": "${VERSION}"
  },
  "channels": {
    "wildcardChannel": {
      "address": "/*",
      "messages": {
        "genericMessage": {
          "payload": {
            "type": "object"
          }
        }
      }
    }
  },
  "operations": {
    "onHandshake": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/wildcardChannel"
      }
    },
    "onHandshakeReply": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/wildcardChannel"
      }
    }
  }
}
